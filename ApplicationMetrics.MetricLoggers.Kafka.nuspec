<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2012/06/nuspec.xsd">
  <metadata>
    <id>ApplicationMetrics.MetricLoggers.Kafka</id>
    <version>1.0.0</version>
    <authors>Alastair Wyse</authors>
    <requireLicenseAcceptance>false</requireLicenseAcceptance>
    <license type="expression">Apache-2.0</license>
    <licenseUrl>https://licenses.nuget.org/Apache-2.0</licenseUrl>
    <projectUrl>https://github.com/alastairwyse/ApplicationMetrics.MetricLoggers.Kafka/</projectUrl>
    <description>An ApplicationMetrics metric logger which writes metric and instrumentation events to a Kafka cluster, and allows consuming the events via a Kafka consumer.</description>
    <summary>An ApplicationMetrics metric logger which writes metric and instrumentation events to a Kafka cluster, and allows consuming the events via a Kafka consumer.</summary>
    <releaseNotes>Initial release.</releaseNotes>
    <copyright>Copyright © Alastair Wyse 2026</copyright>
    <tags>metric metrics instrumentation client application counter statistics kafka cluster producer consumer</tags>
    <icon>images\ApplicationMetrics.png</icon>
    <repository type="git" url="https://github.com/alastairwyse/ApplicationMetrics.MetricLoggers.Kafka/" />
    <readme>docs\README.md</readme>
    <dependencies>
      <group targetFramework="netstandard2.0">
        <dependency id="ApplicationMetrics" version="7.0.0" exclude="Build,Analyzers" />
        <dependency id="Confluent.Kafka" version="2.15.0" exclude="Build,Analyzers" />
        <dependency id="Confluent.SchemaRegistry.Serdes.Protobuf" version="2.15.0" exclude="Build,Analyzers" />
        <dependency id="Google.Protobuf" version="3.35.1" exclude="Build,Analyzers" />
        <dependency id="Grpc.Tools" version="2.82.0" exclude="Build,Analyzers" />
      </group>
    </dependencies>
  </metadata>
  <files>
    <file src=".\ApplicationMetrics.MetricLoggers.MongoDb\bin\Release\netstandard2.0\ApplicationMetrics.MetricLoggers.Kafka.dll" target="lib\netstandard2.0\ApplicationMetrics.MetricLoggers.Kafka.dll" />
    <file src=".\ApplicationMetrics.MetricLoggers.MongoDb\bin\Release\netstandard2.0\ApplicationMetrics.MetricLoggers.Kafka.pdb" target="lib\netstandard2.0\ApplicationMetrics.MetricLoggers.Kafka.pdb" />
    <file src=".\ApplicationMetrics.MetricLoggers.MongoDb\bin\Release\netstandard2.0\ApplicationMetrics.MetricLoggers.Kafka.xml" target="lib\netstandard2.0\ApplicationMetrics.MetricLoggers.Kafka.xml" />
    <file src=".\Resources\ApplicationMetrics.png" target="images\" />
    <file src=".\README.md" target="docs\" />
  </files>
</package>